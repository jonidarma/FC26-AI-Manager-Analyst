{
  "name": "fc26-ai-manager",
  "private": true,
  "version": "1.2.0",
  "description": "FC26 AI Manager — Football Tactical Intelligence System for EA SPORTS FC 26 Career Mode",
  "author": "FC26 AI Manager",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs --packages=external",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "build:electron": "tsc -p electron/tsconfig.json --noEmit && esbuild electron/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-electron/main.cjs --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-electron/preload.cjs --external:electron",
    "build:desktop": "npm run build && npm run build:server && npm run build:electron",
    "electron:start": "npm run build:desktop && electron .",
    "electron:dist:win": "npm run build:desktop && electron-builder --win --x64",
    "import:fc26": "tsx scripts/data-import/import-all.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-electron release server.js",
    "lint": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
